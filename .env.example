# Copy to .env.local and fill in. Every .env* file except this one is gitignored — never commit
# real values.
#
# Which file points at which project (decided 2026-07-27, two projects exist):
#
#   .env.local        the TEST project. Used by `npm run dev` and all local work, so day-to-day
#                     development never writes to real data. Next loads it in development AND in a
#                     production build, where it overrides .env.production.
#   .env.production   the REAL project. Deployment only.
#   .env.test.local   the TEST project again, under E2E_ names (see the block at the bottom).
#                     `npm run test:e2e` reads it through scripts/e2e-env.mjs.
#
# Values: Dashboard → Project Settings → API keys, per project.

# Project URL. Safe to expose — it is in the browser bundle by design.
# Local default: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (formerly "anon"). Safe to expose — RLS is what protects the data behind it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (formerly "service_role"). BYPASSES ROW LEVEL SECURITY COMPLETELY.
#
# Do NOT rename this to NEXT_PUBLIC_SUPABASE_SECRET_KEY — that prefix ships the value to every
# visitor's browser. It was named that way until 2026-07-25; if your existing .env.local still uses
# the old name, rename it here AND rotate the key in the dashboard, because the old one may have
# been exposed.
SUPABASE_SECRET_KEY=


# ─── .env.test.local ──────────────────────────────────────────────────────────
#
# These three go in .env.test.local, NOT here, and they must name the test project. The e2e suite
# seeds a workspace and two users and deletes them again on teardown; e2e/fixtures.ts refuses to run
# unless the app's NEXT_PUBLIC_SUPABASE_URL equals E2E_SUPABASE_URL, so a run that picked up the
# wrong env file stops before it writes anything.
#
# scripts/e2e-env.mjs maps these onto the ordinary names for both `next build` and `playwright test`
# — NEXT_PUBLIC_ values are inlined into the browser bundle at build time, so the build has to point
# at the test project too, not just the server.

E2E_SUPABASE_URL=
E2E_SUPABASE_PUBLISHABLE_KEY=
E2E_SUPABASE_SECRET_KEY=
