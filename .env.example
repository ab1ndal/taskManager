# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
#
# Local development:  values come from `supabase start` (it prints them on startup;
#                     `supabase status` reprints them later).
# Hosted project:     Dashboard → Project Settings → API keys.

# Project URL. Safe to expose — it is in the browser bundle by design.
# Local default: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (formerly "anon"). Safe to expose — RLS is what protects the data behind it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (formerly "service_role"). BYPASSES ROW LEVEL SECURITY COMPLETELY.
#
# Do NOT rename this to NEXT_PUBLIC_SUPABASE_SECRET_KEY — that prefix ships the value to every
# visitor's browser. It was named that way until 2026-07-25; if your existing .env.local still uses
# the old name, rename it here AND rotate the key in the dashboard, because the old one may have
# been exposed.
SUPABASE_SECRET_KEY=
