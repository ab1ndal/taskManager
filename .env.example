# Copy to .env.local and fill in. Every .env* file except this one is gitignored — never commit
# real values.
#
# Two Supabase projects exist as of 2026-07-27:
#
#   .env.local        the THROWAWAY project. Used by `npm run dev`, all local work, and the e2e
#                     suite — they share it deliberately. Next loads .env.local in development AND
#                     in a production build, where it overrides .env.production, so a local
#                     `next build && playwright test` reaches this project and not the real one.
#   .env.production   the REAL project. Deployment only. The same values live in the GitHub and
#                     Vercel environment variables, which is what a deployed build actually reads —
#                     the file is gitignored and never reaches the build.
#
# Values: Dashboard → Project Settings → API keys, per project.

# Project URL. Safe to expose — it is in the browser bundle by design.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (formerly "anon"). Safe to expose — RLS is what protects the data behind it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (formerly "service_role"). BYPASSES ROW LEVEL SECURITY COMPLETELY.
#
# Do NOT rename this to NEXT_PUBLIC_SUPABASE_SECRET_KEY — that prefix ships the value to every
# visitor's browser. It was named that way until 2026-07-25; if your existing .env.local still uses
# the old name, rename it here AND rotate the key in the dashboard, because the old one may have
# been exposed.
SUPABASE_SECRET_KEY=

# ─── e2e only ─────────────────────────────────────────────────────────────────
#
# Declares that the project named above is disposable: the suite seeds a workspace and two users
# into it and deletes them again on teardown. Set it in .env.local, to the SAME URL as
# NEXT_PUBLIC_SUPABASE_URL.
#
# Deliberately absent from .env.production and from the GitHub and Vercel variables. That absence is
# the guard: e2e/fixtures.ts refuses to create a client when this is unset or disagrees with the
# app's target, so a run that picked up production env stops before it writes anything.
#
# Teardown is scoped by tag, so ordinary local data in the shared project survives a run — it
# removes the `e2e-phase65 Household` workspace and the two `e2e-phase65@…` users, nothing else.
E2E_SUPABASE_URL=
